{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/internal/expire-holds",
      "schedule": "0 3 * * *"
    }
  ],
  "buildCommand": "mkdir -p public",
  "framework": null,
  "installCommand": "npm ci --omit=dev",
  "outputDirectory": "public"
}
