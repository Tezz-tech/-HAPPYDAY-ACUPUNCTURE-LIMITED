# Copy to api/.env for local use. Production values are set in the host's dashboard (DEPLOY.md).
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
# Leave MONGODB_URI empty in development: an in-memory replica set is started.
MONGODB_URI=
SESSION_SECRET=
LOG_LEVEL=info
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
