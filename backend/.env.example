# Copy to api/.env for local development. Production values are set in the Vercel dashboard (DEPLOY.md).
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
# Leave MONGODB_URI empty in development: an in-memory replica set is started.
MONGODB_URI=
# At least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=
LOG_LEVEL=info
ADMIN_EMAIL=
# At least 12 characters. The owner must change it on first sign-in.
ADMIN_INITIAL_PASSWORD=
