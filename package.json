{
  "name": "happyday-acupuncture",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "backend",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev -w web\" \"npm run dev -w @happyday/api\"",
    "seed": "npm run seed -w @happyday/api",
    "build": "npm run build -w web && npm run lint-copy",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test -w @happyday/api",
    "test:api": "npm run test -w @happyday/api",
    "test:e2e": "playwright test",
    "lint-copy": "node scripts/lint-copy.js",
    "check:todos": "node scripts/check-todos.js",
    "sync-assets": "node scripts/sync-assets.js",
    "screenshots": "node scripts/screenshots.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "fontkit": "^3.0.0",
    "globals": "^17.14.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "simple-icons": "^16.38.1",
    "vitest": "^5.1.1"
  }
}
